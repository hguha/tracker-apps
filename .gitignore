# Global patterns for the monorepo. App-specific artifact paths live in each app's
# own .gitignore (e.g. apps/reputation/.gitignore for Capacitor/Fastlane artifacts).

# dependencies
node_modules

# build output (any package/app)
dist
.vercel

# logs
*.log
npm-debug.log*

# editor / OS
.DS_Store
.idea
.vscode

# secrets — never commit
.env
.env.*
!.env.example
**/*.p8

# Playwright E2E artifacts
test-results
playwright-report
.playwright
