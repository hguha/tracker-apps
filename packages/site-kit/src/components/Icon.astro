---
/**
 * The handful of Lucide glyphs the pages use, inlined.
 *
 * Lucide as a dependency would ship a whole icon set to render a dozen shapes; these are the same
 * paths on the same 24px grid, copied in. An unknown name renders an empty `<svg>`, so a card with
 * a typo loses its glyph rather than the build.
 */
interface Props {
  name: string
  size?: number
  class?: string
}

const { name, size = 22, class: className } = Astro.props

const PATHS: Record<string, string> = {
