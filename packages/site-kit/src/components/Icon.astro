const paths = (PATHS[name] ?? '').split(' M').map((d, i) => (i === 0 ? d : `M${d}`))
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.9"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden="true"
>
  {paths.map((d) => <path d={d} />)}
</svg>
