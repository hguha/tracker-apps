---
/**
 * The app's mark, served from the site's own `public/icon.svg`.
 *
 * Deliberately an `<img>` of the app's icon rather than inline SVG copied out of it: the icon is
 * already the mark, and a second copy in a component drifts from the one on the home screen.
 */
import { site } from '@site'

interface Props {
  size?: number
  class?: string
}
const { size = 32, class: className } = Astro.props
---

<img src="/icon.svg" width={size} height={size} alt={site.name} class={className} />
