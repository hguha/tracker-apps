---
interface Props {
  color?: string
}

const { color = 'var(--color-accent-bright)' } = Astro.props
---

<p
  class="inline-flex items-center gap-2 rounded-full border border-line bg-surface/80 px-3.5 py-1.5 text-[12.5px] font-semibold text-ink-soft"
>
  <span class="relative flex size-1.5">
    <span
      class="absolute inline-flex size-full animate-ping rounded-full opacity-75"
      style={`background:${color}`}
    ></span>
    <span class="relative inline-flex size-1.5 rounded-full" style={`background:${color}`}></span>
  </span>
  <slot />
</p>
