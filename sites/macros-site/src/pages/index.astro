---
import Base from '@tracker-engine/site-kit/layouts/Base.astro'
import Hero from '@tracker-engine/site-kit/components/Hero.astro'
import Stats from '@tracker-engine/site-kit/components/Stats.astro'
import Spotlight from '@tracker-engine/site-kit/components/Spotlight.astro'
import Conversation from '@tracker-engine/site-kit/components/Conversation.astro'
import FeatureGrid from '@tracker-engine/site-kit/components/FeatureGrid.astro'
import Gallery from '@tracker-engine/site-kit/components/Gallery.astro'
import Faq from '@tracker-engine/site-kit/components/Faq.astro'
import Cta from '@tracker-engine/site-kit/components/Cta.astro'
import Headline from '@/components/Headline.astro'
import { spotlights } from '@/data/features'
import '@/styles/global.css'
---

<Base>
  <Hero>
    <Headline slot="headline" glow />
  </Hero>
  <!-- The marquee sits directly under the hero as the one full-width showcase, then the numbers,
       then the three pillars: getting it in, what the target means, and cooking. -->
  <Gallery />
  <Stats />
  <Spotlight spotlight={spotlights[0]} />
  <Spotlight spotlight={spotlights[1]} flip />
  <Conversation />
  <Spotlight spotlight={spotlights[2]} />
  <FeatureGrid />
  <Faq accent="var(--macro-protein)" />
  <Cta />
</Base>
