---
import { faqs } from '@/data/features'
---

<section id="faq" class="relative py-20 sm:py-28">
  <div class="mx-auto max-w-3xl px-5 sm:px-8">
    <div data-reveal>
      <p class="eyebrow text-region-biceps">Questions</p>
      <h2 class="headline mt-3">The short answers.</h2>
    </div>

    <div class="mt-12 divide-y divide-line border-y border-line" data-reveal>
      {
        faqs.map((faq) => (
          <details class="group">
            <summary
              class="flex cursor-pointer list-none items-center justify-between gap-6 py-6
                text-[16.5px] font-semibold tracking-[-0.01em] transition
                hover:text-accent-bright [&::-webkit-details-marker]:hidden"
            >
              {faq.q}
              <span
                aria-hidden="true"
                class="relative size-4 shrink-0 text-ink-muted transition-transform duration-300 group-open:rotate-45"
              >
                <span class="absolute left-0 top-1/2 h-px w-full -translate-y-1/2 bg-current"></span>
                <span class="absolute left-1/2 top-0 h-full w-px -translate-x-1/2 bg-current"></span>
              </span>
            </summary>
            <p class="max-w-2xl pb-7 text-[15px] leading-relaxed text-ink-muted text-pretty">
              {faq.a}
            </p>
          </details>
        ))
      }
    </div>
  </div>
</section>
