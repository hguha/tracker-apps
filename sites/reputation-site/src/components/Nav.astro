---
import Logo from './Logo.astro'
import Wordmark from './Wordmark.astro'
import { site } from '@/data/site'

const links = [
  { href: '#logging', label: 'Logging' },
  { href: '#insights', label: 'Insights' },
  { href: '#coach', label: 'Coach' },
  { href: '#leagues', label: 'Leagues' },
  { href: '#faq', label: 'FAQ' },
]
---

<header
  class="sticky top-0 z-50 border-b border-line/70 bg-page/80 backdrop-blur-xl backdrop-saturate-150"
>
  <nav class="mx-auto flex h-16 max-w-6xl items-center gap-6 px-5 sm:px-8">
    <a href="#top" class="flex shrink-0 items-center gap-2.5 font-semibold tracking-tight">
      <Logo size={28} class="rounded-[8px]" />
      <Wordmark />
    </a>

    <ul class="hidden flex-1 items-center gap-7 lg:flex">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              class="text-[14.5px] font-medium text-ink-soft transition hover:text-ink"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="ml-auto flex items-center gap-2.5">
      <!-- Flips every screenshot on the page. Set from the button so the page
           works without JS, just pinned to dark. -->
      <button
        id="shots-toggle"
        type="button"
        class="hidden rounded-full border border-line bg-surface px-3.5 py-2 text-[13px] font-semibold text-ink-soft transition hover:border-ink-muted hover:text-ink sm:block"
        aria-pressed="false"
      >
        <span class="shots-label-dark">Light screens</span>
        <span class="shots-label-light">Dark screens</span>
      </button>

      <a href={site.webAppUrl} class="btn-primary px-5 py-2.5 text-[14px]">
        Open the app
      </a>
    </div>
  </nav>
</header>

<style>
  :global(html:not([data-shots='light'])) .shots-label-light,
  :global(html[data-shots='light']) .shots-label-dark {
    display: none;
  }
</style>

<script>
  const toggle = document.getElementById('shots-toggle')
  toggle?.addEventListener('click', () => {
    const isLight = document.documentElement.dataset.shots === 'light'
    document.documentElement.dataset.shots = isLight ? 'dark' : 'light'
    toggle.setAttribute('aria-pressed', String(!isLight))
  })
</script>
