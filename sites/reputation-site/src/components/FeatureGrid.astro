---
import Icon from './Icon.astro'
import { cards } from '@/data/features'
---

<section id="features" class="relative py-14 sm:py-20">
  <div class="mx-auto max-w-6xl px-5 sm:px-8">
    <!-- Just the boxes — six uniform cards that tile cleanly two-up on a phone and
         three-up on desktop. auto-rows-fr keeps a short card level with its row. -->
    <div class="grid auto-rows-fr grid-cols-2 gap-4 sm:gap-5 lg:grid-cols-3">
      {
        cards.map((card, i) => (
          <article
            class="card card-lift group !p-5 sm:!p-7"
            style={`--card-accent:${card.accent}; --reveal-delay:${(i % 3) * 80}ms`}
            data-reveal
          >
            <span
              class="flex size-11 items-center justify-center rounded-2xl transition group-hover:scale-105"
              style={`background: color-mix(in oklab, ${card.accent} 16%, transparent); color:${card.accent}`}
            >
              <Icon name={card.icon} size={21} />
            </span>
            <h3 class="mt-5 text-[17px] font-semibold tracking-[-0.01em]">{card.title}</h3>
            <p class="mt-2 text-[14.5px] leading-relaxed text-ink-muted text-pretty">
              {card.body}
            </p>
          </article>
        ))
      }
    </div>
  </div>
</section>
