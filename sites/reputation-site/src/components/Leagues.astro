---
import Icon from './Icon.astro'
import { leagues } from '@/data/features'
---

<section id="leagues" class="relative isolate overflow-hidden py-14 sm:py-20">
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10">
    <div
      class="absolute left-1/2 top-1/3 h-[34rem] w-[64rem] -translate-x-1/2 rounded-full opacity-20 blur-[130px]"
      style="background: radial-gradient(closest-side, var(--region-shoulders), transparent 72%)"
    >
    </div>
  </div>

  <div class="mx-auto max-w-6xl px-5 sm:px-8">
    <div class="mx-auto max-w-2xl text-center" data-reveal>
      <p
        class="inline-flex items-center gap-2 rounded-full border border-line bg-surface/80 px-3.5 py-1.5 text-[12.5px] font-semibold text-ink-soft"
      >
        <span class="relative flex size-1.5">
          <span
            class="absolute inline-flex size-full animate-ping rounded-full bg-region-shoulders opacity-75"
          ></span>
          <span class="relative inline-flex size-1.5 rounded-full bg-region-shoulders"></span>
        </span>
        {leagues.eyebrow}
      </p>
      <h2 class="headline mt-5">{leagues.title}</h2>
      <p class="lede mx-auto mt-5">{leagues.body}</p>
    </div>

    <!-- The tier ladder: the promotion path, laid out so the pitch is legible at
         a glance without reading a word of the cards below. -->
    <div class="mt-14" data-reveal>
      <ol class="mx-auto flex max-w-3xl flex-wrap items-center justify-center gap-3 sm:gap-4">
        {
          leagues.tiers.map((tier, i) => (
            <>
              <li
                class="flex items-center gap-2.5 rounded-2xl border border-line bg-surface px-4 py-2.5"
                style={`--card-accent:${tier.color}`}
              >
                <span
                  class="size-3 rounded-full"
                  style={`background:${tier.color}; box-shadow:0 0 14px ${tier.color}`}
                ></span>
                <span class="text-[14.5px] font-semibold tracking-[-0.01em]">{tier.name}</span>
              </li>
              {i < leagues.tiers.length - 1 && (
                <li aria-hidden="true" class="text-ink-muted">
                  <Icon name="arrow" size={16} />
                </li>
              )}
            </>
          ))
        }
      </ol>
    </div>

    <div class="mx-auto mt-16 grid max-w-5xl gap-6 md:grid-cols-3">
      {
        leagues.points.map((point, i) => (
          <div
            class="card card-lift"
            style={`--card-accent:var(--region-shoulders); --reveal-delay:${i * 90}ms`}
            data-reveal
          >
            <span
              class="flex size-11 items-center justify-center rounded-2xl"
              style="background: color-mix(in oklab, var(--region-shoulders) 16%, transparent); color: var(--region-shoulders)"
            >
              <Icon name={point.icon} size={21} />
            </span>
            <h3 class="mt-5 text-[16.5px] font-semibold tracking-[-0.01em]">{point.title}</h3>
            <p class="mt-2 text-[14.5px] leading-relaxed text-ink-muted text-pretty">
              {point.body}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>
