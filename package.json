{
  "name": "tracker-apps",
  "version": "0.0.0",
  "description": "Monorepo: shared @tracker-engine/* packages, apps (reputation, ledger, macros), and their marketing sites.",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "sites/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspace reputation && npm run lint --workspace ledger && npm run lint --workspace macros",
    "build": "npm run build --workspace reputation",
    "build:native": "npm run build:native --workspace reputation",
    "build:ledger": "npm run build --workspace ledger",
    "release:ios": "npm run release:ios --workspace reputation",
    "dev": "npm run dev --workspace reputation",
    "dev:ledger": "npm run dev --workspace ledger",
    "dev:site": "npm run dev --workspace reputation-site",
    "build:site": "npm run build --workspace reputation-site",
    "test:e2e": "playwright test --project=reputation --project=macros",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build && npm run build:native && npm run build:macros && npm run build:native:macros && npm run build:site && npm run build:site:macros && npm run test:e2e",
    "dev:macros": "npm run dev --workspace macros",
    "build:macros": "npm run build --workspace macros",
    "test:e2e:live": "playwright test --project=macros-live",
    "build:native:macros": "npm run build:native --workspace macros",
    "native:macros": "npm run native:ios --workspace macros",
    "dev:site:macros": "npm run dev --workspace macros-site",
    "build:site:macros": "npm run build --workspace macros-site"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0"
  }
}
