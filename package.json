{
  "name": "tracker-apps",
  "version": "0.0.0",
  "description": "Monorepo: shared @tracker-engine/* packages + apps (reputation, ledger).",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspace reputation",
    "build": "npm run build --workspace reputation",
    "build:native": "npm run build:native --workspace reputation",
    "build:ledger": "npm run build --workspace ledger",
    "release:ios": "npm run release:ios --workspace reputation",
    "dev": "npm run dev --workspace reputation",
    "dev:ledger": "npm run dev --workspace ledger",
    "dev:site": "npm --prefix sites/reputation-site run dev",
    "build:site": "npm --prefix sites/reputation-site run build",
    "test:e2e": "playwright test",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build && npm run build:native && npm run build:ledger && npm run build:site"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0"
  }
}
