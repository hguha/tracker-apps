default_platform(:ios)

platform :ios do
  desc "Archive a Release build and upload it to TestFlight"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: ENV.fetch("ASC_KEY_PATH"),
    )

    version = get_version_number(xcodeproj: "App.xcodeproj", target: "App")
    build = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: "com.hirshguha.macrocosm",
      version: version,
      initial_build_number: 0,
    ) + 1
    UI.important("Building MACROcosm #{version} (#{build})")

    build_app(
      project: "App.xcodeproj",
      scheme: "App",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "build",
      output_name: "MACROcosm.ipa",
      clean: true,
      xcargs: "-allowProvisioningUpdates CURRENT_PROJECT_VERSION=#{build}",
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
    )
    UI.success("Uploaded MACROcosm #{version} (#{build}) to TestFlight")
  end
end
