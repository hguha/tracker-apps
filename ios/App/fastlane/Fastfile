# Build + upload REPutation to TestFlight in one command.
# Run via `npm run release:ios` from the repo root (builds the web app, syncs
# Capacitor, then runs `fastlane beta` here). Secrets come from the git-ignored
# fastlane/.env: ASC_KEY_ID, ASC_ISSUER_ID, ASC_KEY_PATH.

default_platform(:ios)

platform :ios do
  desc "Archive a Release build and upload it to TestFlight"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: ENV.fetch("ASC_KEY_PATH"),
    )

    version = get_version_number(xcodeproj: "App.xcodeproj", target: "App")
    # Next build = one past the highest already on TestFlight for this version,
    # so build numbers never collide and we don't have to track them by hand.
    build = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: "com.hirshguha.fitnote",
      version: version,
      initial_build_number: 0,
    ) + 1
    UI.important("Building REPutation #{version} (#{build})")

    build_app(
      project: "App.xcodeproj",
      scheme: "App",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "build",
      output_name: "REPutation.ipa",
      clean: true,
      # Override the build number for this archive (no project edit, no agvtool),
      # and let Xcode fetch/refresh the App Store provisioning profile if needed.
      xcargs: "-allowProvisioningUpdates CURRENT_PROJECT_VERSION=#{build}",
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
    )
    UI.success("Uploaded REPutation #{version} (#{build}) to TestFlight ✈️")
  end
end
